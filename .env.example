# ─────────────────────────────────────────────────────────────
# Designally Content Studio — environment configuration
# Copy to .env.local (dev) or .env (docker) and fill in.
# All secrets are server-side only and never exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Database (Postgres / Supabase).
# Leave EMPTY to use embedded PGlite in ./data — zero external services,
# good for local dev and demos. Set it to a Postgres/Supabase connection
# string for production. For Supabase, use the SESSION pooler connection
# string (port 5432) — not the transaction pooler on 6543, which breaks this
# app (see INTEGRATION.md §11). The app sets prepare:false for the pooler.
# Example:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Session signing secret, used by NextAuth. REQUIRED in production.
# Generate one with:  openssl rand -hex 32
# Changing it signs everyone out; it does not lose any data.
AUTH_SECRET=

# ─── Sign-in: Google, restricted to the designally.co Workspace ───
# Create an OAuth client in Google Cloud (type: Web application). Because the
# consent screen can be Internal for a Workspace org, there is no verification
# review and no cost.
#   Authorised redirect URI:  {origin}/api/auth/callback/google
#   e.g. http://localhost:3000/api/auth/callback/google  (local)
#        https://<your-domain>/api/auth/callback/google  (deployed)
# REQUIRED — Google is the only way in, in every environment including local
# development, so add the localhost callback to the same client. The production
# build fails without these, because a deploy nobody can sign into is worth
# catching at build time.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Image storage: Cloudflare R2 ────────────────────────────
# Every generated image and reference photograph is stored here, and its row
# records the full public URL. All five, or none:
#   none set  images go to ./data/images — fine locally and self-hosted,
#             REFUSED on Vercel, whose disk lasts one request.
#   some set  an error naming the ones missing.
# Token: R2 → Manage API tokens → "Object Read & Write", scoped to the bucket.
# R2_PUBLIC_URL is the bucket's custom domain with NO path, e.g.
# https://images.example.com — the object key is read back out of the URL's
# path, so the domain has to serve the bucket from its root.
# The Hub fetches covers from this domain, so the same hostname must be in the
# Hub's MEDIA_FETCH_HOSTS, or it refuses them.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Routines (write and publish on a schedule) ──────────────
# The endpoint that drives the autopilot is reached by a scheduler, not by a
# signed-in person, so it authenticates with this shared secret instead of a
# session. WITHOUT IT THE ENDPOINT REFUSES TO RUN AT ALL — failing closed is the
# only safe default for a URL that spends credit and posts to a live site.
#   openssl rand -hex 32
#
# Then give the same value to whatever pokes it. The repository ships a
# Cloudflare Worker in workers/autopilot-poker, which needs two secrets:
#   AUTOPILOT_URL      https://<your-app>/api/cron/autopilot
#   AUTOPILOT_SECRET   this value
# Vercel's own cron (vercel.json) also calls it daily as a backstop and sends
# this header for you.
#
# Routines are created and switched on in the app's Routines tab, and each one
# carries its own days, hour and time zone. Setting this key starts nothing.
CRON_SECRET=

# ─── Unsplash (reference photographs for image generation) ───
# Optional but strongly recommended. "True to life" images are built by finding
# a photograph of the SCENE the article describes — a designer at a desk, a
# typographer at a press — and generating the same kind of picture from it.
# Unsplash is where those photographs come from.
#
# Create a free app at https://unsplash.com/oauth/applications and copy the
# Access Key (not the Secret). The Demo tier allows 50 requests an hour, which
# is far more than this app needs; apply for production if you outgrow it.
#
# Without it the app falls back to Openverse, which needs no key but leans
# towards archive and museum material and rarely has a picture of somebody
# working.
UNSPLASH_ACCESS_KEY=

# ─── Designally Knowledge Hub (publish target) ───────────────
# Where finished articles are published (the Hub's Payload CMS). Articles are
# posted as DRAFTS via POST {HUB_BASE_URL}/api/articles/from-markdown.
#   HUB_BASE_URL  the Hub's origin, e.g. http://localhost:3000 (dev) or https://hub.designally.co
#   HUB_API_KEY   a `users` API key generated in the Hub admin (the "Content Generator" user)
HUB_BASE_URL=
HUB_API_KEY=

# ─── Local fallbacks in a production build ───────────────────
# In production (`npm start`, the container image) the app refuses to run
# without DATABASE_URL, ENCRYPTION_KEY or the R2_* variables, instead of
# quietly using PGlite, a generated key and ./data/images. Set this to 1 only
# to try a production build on your own machine. Never on a deployment.
# ALLOW_LOCAL_FALLBACKS=1
